<html lang="th"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>DATAR</title>
<style>
body {
  margin:0;
  font-family:"Segoe UI", Tahoma, sans-serif;
  background:linear-gradient(135deg,#0d0d0d,#1a1a1a);
  color:#fff;
  display:flex;
  justify-content:center;
  align-items:flex-start;
  min-height:100vh;
  padding:30px;
  overflow:hidden;
}
.container {
  position:relative;
  background:#111;
  border-radius:16px;
  padding:20px;
  padding-top:60px;
  box-shadow:0 0 12px rgba(0,0,0,0.6);
  max-width:400px;
  width:100%;
  text-align:center;
  overflow:hidden;
}
.logo {
position:absolute;
  top:10px;
  right:14px;
  display:flex;
  align-items:center;
  gap:6px;
  background:rgba(20,20,20,0.85);
  padding:4px 8px;
  border-radius:12px;
}
.logo img { width:28px; height:28px; border-radius:6px; object-fit:cover; }
.logo span { font-size:13px; font-weight:600; color:#00ff80; white-space:nowrap; }

.warning-card {
  background:#ff4040; color:#fff; font-weight:bold;
  padding:10px 16px; border-radius:10px; margin-bottom:20px;
  font-size:14px; text-align:center;
  box-shadow:0 0 12px rgba(255,64,64,0.6);
}

.icon-grid {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:18px;
  margin-bottom:25px;
  margin-top:20px;
}

.app-box {
  background:#1c1c1c;
  border-radius:14px;
  padding:15px;
  box-shadow:inset 0 0 6px rgba(255,255,255,0.05);
  display:flex;
  flex-direction:column;
  align-items:center;
}
.app-icon {
  width:64px; height:64px;
  object-fit:contain;
  border:2px solid rgba(255,255,255,0.4);
  border-radius:12px;
  padding:6px;
  background:rgba(255,255,255,0.05);
  margin-bottom:6px;
}
.app-logo {
  width:100px;
  height:auto;
  margin-bottom:10px;
}
.open-btn {
  display:inline-block;
  padding:10px 16px;
  border:none;
  border-radius:10px;
  background:#00ff80;
  color:#000;
  font-weight:bold;
  cursor:pointer;
  box-shadow:0 0 12px #00ff80,0 0 20px #00ff80;
  transition:transform 0.2s;
}
.open-btn:hover { transform:scale(1.05); }

.file-btn {
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:10px 18px;
  border-radius:12px;
  border:2px solid rgba(255,255,255,0.4);
  background:linear-gradient(135deg,rgba(255,255,255,0.05),rgba(200,200,200,0.08));
  color:#fff;
  font-weight:bold;
  cursor:pointer;
  font-size:14px;
  box-shadow:0 0 10px rgba(255,255,255,0.2);
  transition:transform 0.2s, background 0.3s, box-shadow 0.3s, border 0.3s;
}
.file-btn:hover {
  transform:scale(1.05);
  border-color: rgba(255,255,255,0.7);
  box-shadow:0 0 16px rgba(255,255,255,0.4);
}
.file-btn input[type="file"] { display:none; }

.merge-btn {
  display:inline-block;
  margin-top:15px;
  padding:12px 20px;
  border:none;
  border-radius:12px;
  font-weight:bold;
  font-size:14px;
  color:#fff;
  background:#333;
  box-shadow:0 0 6px rgba(0,0,0,0.5);
  cursor:not-allowed;
  transition:transform 0.2s, background 0.3s, box-shadow 0.3s;
}
.merge-btn.enabled {
  background:linear-gradient(135deg,#00c6ff,#0072ff);
  box-shadow:0 0 12px rgba(0,114,255,0.8),0 0 20px rgba(0,198,255,0.6);
  cursor:pointer;
}
.merge-btn.enabled:hover {
  transform:scale(1.05);
  background:linear-gradient(135deg,#0072ff,#00c6ff);
  box-shadow:0 0 16px rgba(0,114,255,1),0 0 28px rgba(0,198,255,0.8);
}

.status {
  margin-top:10px;
  font-size:14px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:6px;
  justify-content:center;
}

.status-row {
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap: wrap; /* ให้ชื่อไฟล์ยาวขึ้นบรรทัดใหม่ */
}

.status-row div { 
  flex-shrink: 0; /* ไม่ให้บีบชื่อไฟล์ */
  min-width: 0; 
}

.status-row img.file-preview {
  width:32px; height:32px;
  object-fit:contain;
  border:1px solid rgba(255,255,255,0.3);
  border-radius:6px;
  padding:2px;
}

.circle { 
  width:14px; 
  height:14px; 
  border-radius:50%; 
  flex:0 0 auto; /* ป้องกันถูกยืดเป็นวงรี */
}

.credit {
  margin-top:30px;
  font-size:18px;
  font-weight:800;
  font-family:"Arial Black",Impact,sans-serif;
  text-align:center;
  color:#ccc;
}


.range-track {
  position: relative;
  background: #232328;
  height: 12px;
  border-radius: 12px;
  box-shadow: inset 0 0 8px rgba(0,0,0,0.6);
  overflow: visible; 
}
/* Filled Glow Align */
.track-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 50%;
  border-radius: 12px;
  background: linear-gradient(90deg,#7a00ff,#00e6ff);
  box-shadow: 0 0 18px #7a00ff;
  z-index: 1;
}

/* Perfect Thumb Centering */
input[type=range] {
  appearance: none;
  width: 100%;
  background: transparent;
  position: relative;
  z-index: 3;
  height: 12px;
  margin: 0;
  padding: 0;
}

/* Center-aligned thumb */
input[type=range]::-webkit-slider-thumb {
  appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #ffffff;
  border: 2px solid #7a00ff;
  box-shadow: 0 0 10px #7a00ff;
  margin-top: -15px; /* Adjust till perfect center */
  cursor: pointer;
}

input[type=range]::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #ffffff;
  border: 2px solid #7a00ff;
  box-shadow: 0 0 10px #7a00ff;
  cursor: pointer;
}
.credit {
    text-align: center;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 14px;
    letter-spacing: 0.3px;
    user-select: none;
  }
</style>
</head>
<body>
<div class="container">
  <div class="logo">
    <img src="https://img2.pic.in.th/pic/logo-THADA-X-DATAR-07-11-252.png" alt="Logo">
    <span>HEAD SHOT</span>
  </div>

  <div class="warning-card">
    ⚠️ โปรดตรวจสอบไฟล์ก่อนอัปโหลด เพื่อความถูกต้องของระบบ!
  </div>

  <div class="icon-grid">
    <div class="app-box">
      <img class="app-icon" src="https://play-lh.googleusercontent.com/1wE91ae_1YIJtIjQ1YJz5RhAajxEpF1TfrXGg7tcrKl90MOnF7XdFj71pw_MSQbyhM5PYz-eRdeBFQBzSGrV=w480-h960" alt="App1">
      <img class="app-logo" src="https://dl.dir.freefiremobile.com/common/web_event/official2/dist/client/img/full_logo.969f536.png" alt="Free Fire Logo">
      <button class="open-btn">เปิดแอพ</button>
    </div>
    <div class="app-box">
      <img class="app-icon" src="https://play-lh.googleusercontent.com/fPV15zPzpECONm08K6BUS5EqD1A1Ir_hxsOaaJF7hOIK-BNDpFO-i3MAvUVM7952JJyGAhg1VJwzDKtYT2QB8Ns=w480-h960" alt="App2">
      <img class="app-logo" src="https://dl.dir.freefiremobile.com/common/web_event/official2/dist/client/img/max_logo.b96cbd2.png" alt="Free Fire MAX Logo">
      <button class="open-btn">เปิดแอพ</button>
    </div>
  </div>
  <label class="file-btn">
    เลือกไฟล์
    <input type="file" id="fileInput" multiple="">
  </label>
  <div id="statusMessage" class="status"></div>
<div class="slider-card">
  <div class="slider-title">ปรับความเร็วของจอ</div>

  <div class="slider-wrapper">
    <div class="range-track">
      <div class="track-fill" id="trackFill" style="width: 100%;"></div>
      <input type="range" id="dpiRange" min="0" max="1200" value="600" step="1">
    </div>

    <div class="dpi-row">
      <div class="dpi-label"> <strong>CONFIG DPI</strong></div>
      <div class="dpi-value" id="dpiValue">1200</div>
    </div>
  </div>
</div>

  <button id="mergeBtn" class="merge-btn" disabled="">ผนวกไฟล์</button>

  <p class="credit">© 2025 Copyright
@datarshop (DATARSHOP) - All rights reserved And the creator.</p>
</div>

<script>
const fileInput = document.getElementById('fileInput');
const mergeBtn = document.getElementById('mergeBtn');
const statusMessage = document.getElementById('statusMessage');

fileInput.addEventListener('change', () => {
  const files = fileInput.files;
  statusMessage.innerHTML = '';

  if (files.length > 2) {
    alert('⚠️ สามารถเลือกไฟล์ได้สูงสุด 2 ไฟล์เท่านั้น');
    fileInput.value = '';
    mergeBtn.disabled = true;
    mergeBtn.classList.remove('enabled');
    return;
  }

  if (!files.length) {
    mergeBtn.disabled = true;
    mergeBtn.classList.remove('enabled');
    return;
  }

  let allValid = true;
  const fileDisplays = Array.from(files).map(file => {
    let ext = file.name.includes('.') ? file.name.split('.').pop().toLowerCase() : '';
    let displayType = '';
    let iconUrl = '';

    if (ext === 'py') {
      displayType = '.py';
      iconUrl = 'https://icon-library.com/images/python-file-icon/python-file-icon-2.jpg';
    } else {
      displayType = 'ไม่รองรับ';
      allValid = false;
      iconUrl = 'https://cdn-icons-png.flaticon.com/512/753/753345.png';
    }

    return `<div class="status-row">
      <img class="file-preview" src="" alt="">
      <div style="display:flex; flex-direction:column; align-items:flex-start;">
        <span style="color:#00ff80;font-weight:600;"></span>
        <span style="font-size:12px;color:#ccc;">ประเภทไฟล์: </span>
      </div>
      <span class="circle" style="background:'#ff4040'"></span>
    </div>`;
  });

  if (allValid) {
    statusMessage.innerHTML = fileDisplays.join('');
    mergeBtn.disabled = false;
    mergeBtn.classList.add('enabled');
  } else {
    statusMessage.innerHTML = `<span style="color:#ff4040">❌ไฟล์ไม่ถูกต้อง</span>`;
    mergeBtn.disabled = true;
    mergeBtn.classList.remove('enabled');
  }
});

mergeBtn.addEventListener('click', () => {
  if (!mergeBtn.disabled && fileInput.files.length) {
    Array.from(fileInput.files).forEach(file => {
      const successMsg = document.createElement('div');
      successMsg.style.color = '#00ff80';
      successMsg.style.fontWeight = '600';
      successMsg.textContent = `✅ ผนวกไฟล์ "" สำเร็จ`;
      statusMessage.appendChild(successMsg);
    });
  }
});
const slider = document.getElementById('dpiRange');
const dpiValue = document.getElementById('dpiValue');
const trackFill = document.getElementById('trackFill');

function updateSlider() {
  const max = slider.max;
  const value = slider.value;
  const percent = (value / max) * 100;

  trackFill.style.width = percent + '%';
  dpiValue.textContent = value;
}

slider.addEventListener('input', updateSlider);
updateSlider();
document.querySelectorAll('.app-box')[0].querySelector('.open-btn')
  .addEventListener('click', () => {
    alert('กำลังเปิด.. Free Fire');
    // 👉 ถ้าต้องการลิงก์แทน alert ให้ใช้ window.open()
    // window.open('freefire://', '_blank');
  });

// ปุ่มเปิดแอพ Free Fire MAX (App2)
document.querySelectorAll('.app-box')[1].querySelector('.open-btn')
  .addEventListener('click', () => {
    alert('กำลังเปิด.. Free Fire MAX');
    // window.open('freefiremax://', '_blank');
  });
// Free Fire (iOS)
document.querySelectorAll('.app-box')[0].querySelector('.open-btn')
  .addEventListener('click', () => {
    window.location.href = "freefire://";
    // ถ้าไม่มีแอพ จะเปลี่ยนเส้นทางไป App Store หลัง 2 วินาที
    setTimeout(() => {
      window.location.href = "https://apps.apple.com/th/app/garena-free-fire-4nniversary/id1300146617";
    }, 2000);
  });

// Free Fire MAX (iOS)
document.querySelectorAll('.app-box')[1].querySelector('.open-btn')
  .addEventListener('click', () => {
    window.location.href = "freefiremax://";
    setTimeout(() => {
      window.location.href = "https://apps.apple.com/th/app/free-fire-max/id1480518558";
    }, 2000);
  });
</script>

</body></html>
